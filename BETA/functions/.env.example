# Non-secret Firebase parameters; the CLI prompts and stores real values in
# BETA/functions/.env.<PROJECT_ID>, excluded by .gitignore.
BETA_FIREBASE_DATABASE_URL=https://YOUR-ISOLATED-BETA-DATABASE.europe-west1.firebasedatabase.app
BETA_ADMIN_EMAIL=your-verified-admin@example.no
BETA_EMAIL_FROM=orders@your-verified-domain.example
# BETA_SESSION_SECRET, BETA_SMS_GATEWAY_TOKEN and BETA_RESEND_API_KEY
# are Firebase Secret Manager secrets, NEVER stored in .env or git.
