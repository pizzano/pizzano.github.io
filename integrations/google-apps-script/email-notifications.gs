/**
 * KØL Grill & Pizza — independent email-only Google Apps Script.
 * Deploy as a Web App: Execute as Me; access Anyone (authenticated using HMAC).
 * Configure Script Properties: EMAIL_WEBHOOK_SECRET (min 32 random chars).
 * Never put this secret in customer-facing JavaScript.
 * The caller MUST send the HMAC-SHA256 hex signature of the JSON payload
 * as the "sig" URL query parameter, generated by a trusted server.
 * SMS gateway is not used or modified.
 */
const SHOP_NAME = 'KØL Grill & Pizza';
const FROM_NAME = SHOP_NAME;
const TZ = 'Europe/Oslo';

function doPost(e) {
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const raw = (e && e.postData && e.postData.contents) || '';
    const sig = String((e && e.parameter && e.parameter.sig) || '');
    const secret = PropertiesService.getScriptProperties().getProperty('EMAIL_WEBHOOK_SECRET');
    if (!secret || secret.length < 32 || !raw || !sig || !verifySignature_(raw, sig, secret)) {
      return reply_({ok:false, error:'unauthorized'});
    }
    const data = JSON.parse(raw);
    const kind = String(data.kind || '');
    const orderId = String(data.orderId || '').trim();
    const email = String(data.email || '').trim();
    if (!['accepted','ready'].includes(kind) || !/^[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}$/.test(email) || !orderId || orderId.length > 100) {
      return reply_({ok:false,error:'invalid_payload'});
    }
    const key = 'sent_' + Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, orderId + ':' + kind)).slice(0,40);
    const props = PropertiesService.getScriptProperties();
    if (props.getProperty(key)) return reply_({ok:true,duplicate:true});
    const firstName = String(data.customerName || '').trim().split(/\s+/)[0].slice(0,40);
    const greeting = firstName ? 'Hei ' + firstName + '!' : 'Hei!';
    const ref = orderId.slice(-6).toUpperCase();
    let subject, body;
    if (kind === 'accepted') {
      subject = 'Bestilling #' + ref + ' er bekreftet – ' + SHOP_NAME;
      let pickup = String(data.pickupText || '').trim().slice(0,80);
      body = greeting + '\n\nDin bestilling #' + ref + ' er bekreftet.\n' +
        (pickup ? 'Estimert hentetid: ' + pickup + '\n' : 'Vi gir beskjed når maten er klar.\n');
    } else {
      subject = 'Bestilling #' + ref + ' er klar for henting – ' + SHOP_NAME;
      body = greeting + '\n\nMaten er klar for henting!\nBestilling #' + ref + '\n';
    }
    body += '\nHentested: Øgardsvegen 44, Skarnes.\n\nHilsen\n' + SHOP_NAME;
    // Mark before sending to prevent parallel duplicates. Failed sends need manual inspection.
    props.setProperty(key, String(Date.now()));
    try {
      MailApp.sendEmail({to:email, subject:subject, body:body, name:FROM_NAME});
    } catch (err) {
      // Clear reservation on definitive Apps Script send errors; caller should inspect response.
      props.deleteProperty(key);
      return reply_({ok:false,error:'send_failed'});
    }
    return reply_({ok:true});
  } catch (err) {
    return reply_({ok:false,error:'internal_error'});
  } finally {
    lock.releaseLock();
  }
}

function verifySignature_(payload, signature, secret) {
  if (!/^[0-9a-f]{64}$/i.test(signature)) return false;
  const bytes = Utilities.computeHmacSha256Signature(payload, secret, Utilities.Charset.UTF_8);
  const expected = bytes.map(function(b) { return ('0' + (b & 255).toString(16)).slice(-2); }).join('');
  let diff = 0;
  for (let i = 0; i < expected.length; i++) diff |= expected.charCodeAt(i) ^ signature.toLowerCase().charCodeAt(i);
  return diff === 0;
}

function reply_(data) {
  return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);
}

/** Run once from the script editor to authorize MailApp and verify sender account. */
function testEmailToSelf() {
  const address = Session.getEffectiveUser().getEmail();
  if (!address) throw new Error('No authenticated sender email found');
  MailApp.sendEmail({to:address, subject:'KØL e-posttest', body:'E-postvarslinger er klare for tilkobling.', name:FROM_NAME});
  Logger.log('Email test sent to script owner.');
}
